# Runtime image for the CentOS Stream 9 TPC jobs (x86 and arm64), which check that the static
# native library runs on a plain CentOS 9. It adds only JDKs and CI tools to the OS image, no
# native libraries. All JDKs are installed side by side under /usr/lib/jvm/java-<version>-openjdk;
# jobs select one through JAVA_HOME instead of installing it at runtime.
# Produces the apache/gluten:centos-9-runtime image.
FROM quay.io/centos/centos:stream9

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

COPY dev/docker/install-ci-tools.sh /opt/ci/install-ci-tools.sh
RUN set -ex; \
    dnf update -y; \
    dnf install -y java-1.8.0-openjdk-devel java-11-openjdk-devel java-17-openjdk-devel \
        java-21-openjdk-devel wget tar gzip git procps-ng which findutils tzdata python3; \
    bash /opt/ci/install-ci-tools.sh; \
    dnf clean all; \
    rm -rf /var/cache/dnf
